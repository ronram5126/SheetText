<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="TaskPane">
  <Id>SheetText.RichTextEditor</Id>
  <Version>1.0.0</Version>
  <ProviderName>SheetText</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="SheetText Rich Text" />
  <Description DefaultValue="Edit cell contents as rich text" />
  <IconUrl DefaultValue="https://example.com/icon.png" />
  <AppDomains>
    <AppDomain>https://example.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="SharedRuntime" MinVersion="1.1" />
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://example.com/taskpane.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <FunctionFile resid="residFuncUrl" />
          <ExtensionPoint xsi:type="ContextMenuTheCell">
            <Label resid="residLabel" />
            <CommandUID>SheetTextContextMenu</CommandUID>
            <SourceLocation resid="residTaskpaneUrl" />
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" />
      <bt:Urls xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
        <bt:Url id="residTaskpaneUrl" DefaultValue="https://example.com/taskpane.html" />
        <bt:Url id="residFuncUrl" DefaultValue="https://example.com/function-file.html" />
      </bt:Urls>
      <bt:ShortStrings xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
        <bt:String id="residLabel" DefaultValue="Edit as Rich Text" />
      </bt:ShortStrings>
      <bt:LongStrings xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" />
    </Resources>
  </VersionOverrides>
</OfficeApp>
